# romtool for the Amiga image of romemul-switcher-rom (EPIC-00 STORY-01):
# amitools 0.8.1, the version sidecartos-config pins, on a pinned Python.
FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
RUN pip install --no-cache-dir --disable-pip-version-check amitools==0.8.1
ENTRYPOINT ["romtool"]
